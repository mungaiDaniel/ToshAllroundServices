# ---- Contact form email (Web3Forms) – free access key from https://web3forms.com
VITE_WEB3FORMS_KEY=

# ---- Supabase (content backend). Project Settings → API in your Supabase dashboard.
# Both of these are PUBLIC and safe in the browser (the database rules limit what visitors can do):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- ONLY for `npm run seed` (never exposed to the website, never commit it).
# Project Settings → API → "service_role" key. Delete it again after seeding if you like.
SUPABASE_SERVICE_ROLE_KEY=

# How to use: copy this file to ".env", fill in the values, restart `npm run dev`.
